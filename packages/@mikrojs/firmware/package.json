{
  "name": "@mikrojs/firmware",
  "version": "0.21.0",
  "description": "Mikro.js ESP32 firmware: ESP-IDF component, build tools, and project template",
  "keywords": [
    "esp-idf",
    "esp32",
    "firmware",
    "mikrojs"
  ],
  "homepage": "https://github.com/mikrojs/mikro#readme",
  "bugs": {
    "url": "https://github.com/mikrojs/mikro/issues"
  },
  "license": "MIT",
  "author": "Bjørge Næss <bjoerge@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikrojs/mikro.git"
  },
  "bin": {
    "mikro-fw": "bin/mikro-fw.js"
  },
  "files": [
    "bin",
    "dist",
    "components",
    "default-app",
    "prebuilds",
    "sdkconfig.defaults",
    "sdkconfig.defaults.*",
    "partitions.csv",
    "chips.json",
    "project.cmake",
    "resolve.cmake"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./inputs": {
      "development": "./src/inputs.ts",
      "import": "./dist/inputs.js"
    },
    "./manifest": {
      "development": "./src/manifest.ts",
      "import": "./dist/manifest.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./inputs": {
        "types": "./dist/inputs.d.ts",
        "default": "./dist/inputs.js"
      },
      "./manifest": {
        "types": "./dist/manifest.d.ts",
        "default": "./dist/manifest.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build:ts": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node scripts/verify-prebuilds.js",
    "publint": "publint",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@mikrojs/native": "workspace:*",
    "@mikrojs/quickjs": "workspace:*",
    "@optique/core": "catalog:",
    "@optique/run": "catalog:",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "catalog:node24"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
