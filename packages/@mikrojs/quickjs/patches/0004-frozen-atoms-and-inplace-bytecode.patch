+/* mikrojs patch: intern a fixed list of atoms right after runtime creation
+ * so that blobs compiled against the same list (in a runtime that ran the
+ * same preload) can reference them by final id, with no relocation at load
+ * time. The returned mapping is validated between writer and reader via a
+ * hash over every dynamic atom's string and id, so any divergence in the
+ * runtime's pre-preload atom state rejects the blob instead of silently
+ * resolving atoms to the wrong strings. The references taken here are
+ * intentionally never released: frozen atoms live for the runtime's
+ * lifetime (JS_FreeRuntime frees all remaining atom structs wholesale).
+ * Names must be raw 8-bit strings. Returns 0 on success. */
+int JS_PreloadFrozenAtoms(JSRuntime *rt, const char *const *names,
+                          const uint32_t *lens, uint32_t count)
+{
+    uint32_t i, h, end;
+    JSAtom atom;
+
+    if (rt->frozen_atom_end != JS_ATOM_END || rt->frozen_atom_hash != 0)
+        return -1; /* already preloaded */
+    end = JS_ATOM_END;
+    for (i = 0; i < count; i++) {
+        atom = __JS_NewAtomInit(rt, names[i], (int)lens[i],
+                                JS_ATOM_TYPE_STRING);
+        if (atom == JS_ATOM_NULL)
+            return -1;
+        if (!__JS_AtomIsTaggedInt(atom) && atom + 1 > end)
+            end = atom + 1;
+    }
+    /* hash the entire dynamic atom range, not just the preloaded names:
+       atoms created before the preload (e.g. class init) also serialize
+       as final ids once the boundary is raised */
+    h = 5381;
+    for (i = JS_ATOM_END; i < end; i++) {
+        JSAtomStruct *p = rt->atom_array[i];
+        if (atom_is_free(p)) {
+            h = h * 33 ^ 0xfe;
+            continue;
+        }
+        h = h * 33 ^ p->atom_type;
+        if (p->is_wide_char) {
+            uint32_t j;
+            for (j = 0; j < p->len; j++) {
+                h = h * 33 ^ (str16(p)[j] & 0xff);
+                h = h * 33 ^ (str16(p)[j] >> 8);
+            }
+        } else {
+            uint32_t j;
+            for (j = 0; j < p->len; j++)
+                h = h * 33 ^ str8(p)[j];
+        }
+        h = h * 33 ^ 0xff;
+    }
+    rt->frozen_atom_end = end;
+    rt->frozen_atom_hash = h | 1; /* nonzero marks "loaded" */
+    return 0;
+}
