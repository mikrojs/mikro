+    str8(p)[len] = '\0';
+    h = hash_string8((const uint8_t *)name, len, JS_ATOM_TYPE_STRING);
+    h &= JS_ATOM_HASH_MASK;
+    p->hash = h;
+    p->atom_type = JS_ATOM_TYPE_STRING;
+    p->first_weak_ref = NULL;
