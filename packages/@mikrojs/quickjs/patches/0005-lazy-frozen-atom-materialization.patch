+    rt->atom_array = new_array;
+    rt->atom_free_index = start;
+    for(i = start; i < new_size; i++) {
+        uint32_t next;
+        if (i == (new_size - 1))
+            next = 0;
+        else
+            next = i + 1;
+        rt->atom_array[i] = atom_set_free(next);
+    }
+    return 0;
