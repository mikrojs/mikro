{
  "$comment": "Single source of truth for builtin runtime modules. Read by both CMake builds, the mikro CLI, the tsconfig preset emitter and the simulator tests. The fields are documented at the top of scripts/modules-list.js. Order matters.",
  "modules": [
    {"name": "abort", "public": false},
    {"name": "cbor"},
    {"name": "env"},
    {"name": "result"},
    {"name": "schema"},
    {"name": "fs"},
    {"name": "http/server", "native": "http_server", "feature": "wifi"},
    {"name": "kv/nvs", "native": "nvs_kv"},
    {"name": "kv/rtc", "native": "rtc"},
    {"name": "kv/shared", "public": false},
    {"name": "module"},
    {"name": "observable"},
    {"name": "observable/lazy", "public": false},
    {"name": "ota", "native": "ota"},
    {"name": "ota/client", "native": "ota_client"},
    {"name": "ota/config", "public": false},
    {"name": "reader"},
    {"name": "sleep", "native": "sleep"},
    {"name": "sntp", "native": "sntp"},
    {"name": "stdio"},
    {"name": "stream"},
    {"name": "sys"},
    {"name": "test"},
    {"name": "udp"},
    {"name": "watchdog"},
    {"name": "ble", "native": "ble", "feature": "ble", "when": "ble"},
    {"name": "gpio", "bytecode": false, "native": "gpio"},
    {"name": "i2c", "bytecode": false, "native": "i2c"},
    {"name": "i2s", "bytecode": false, "native": "i2s", "feature": "i2s"},
    {"name": "spi", "bytecode": false, "native": "spi"},
    {"name": "uart", "bytecode": false, "native": "uart"},
    {"name": "pwm", "bytecode": false, "native": "pwm"},
    {"name": "neopixel", "bytecode": false, "native": "neopixel"},
    {"name": "http/request", "bytecode": false, "native": "http"},
    {"name": "http/helpers", "bytecode": false},
    {"name": "observable/operators", "bytecode": false},
    {"name": "inspect", "bytecode": false},
    {"name": "wifi", "bytecode": false, "native": "wifi", "feature": "wifi", "when": "wifi"}
  ]
}
